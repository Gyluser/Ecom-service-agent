{
  "dataset": "Ecom Context Compression Stress Test adapted from tau-bench Retail",
  "version": 1,
  "evaluation_mode": "context_only",
  "memory_enabled": false,
  "mapping_policy": "只使用当前 Ecom Mock 订单、商品和工具；不模拟 tau-bench 原始数据库状态。",
  "evaluation_policy": {
    "focus": "context_continuity",
    "tool_calls": "diagnostic_not_required_at_exact_turn",
    "keyword_match": "all_required_with_alternatives",
    "fact_match": "exact_or_variants"
  },
  "cases": [
    {
      "id": "context_01",
      "description": "延迟提供订单号并在多轮闲聊后查询订单详情",
      "turns": [
        "我想查一下我的订单，但暂时想不起订单号。",
        "我记得买的是一双运动鞋。",
        "先不用查了，我想问一下已经发货的商品还能不能申请退款。",
        "如果只是想了解政策，需要现在就提交申请吗？",
        "明白了，我还是想回到刚才的订单查询。",
        "订单号是 ORD-20240115-001。",
        "请告诉我这笔订单买了什么、现在是什么状态。",
        "另外请确认一下订单金额。"
      ],
      "expected_intent": "order_query",
      "expected_keywords": ["Nike", "899"],
      "expected_requires_human": false,
      "expected_tools": ["query_order"],
      "min_tool_calls": 1,
      "max_tokens": 30000,
      "category": "context_stress",
      "source_task_id": "54",
      "mapping_notes": "延迟提供订单号，测试早期目标和后期订单号能否跨压缩保留。",
      "expected_business_checks": [
        {
          "tool": "query_order",
          "result_keywords": ["success", "ORD-20240115-001"],
          "arguments": {"order_id": "ORD-20240115-001"}
        }
      ],
      "context_facts": [
        {"id": "target_order", "content": "ORD-20240115-001", "content_variants": ["Nike Air Max 270 运动鞋", "¥899.00", "已发货"], "introduced_at": 6, "required_at": [7, 8], "critical": true}
      ],
      "turn_assertions": [
        {"turn_index": 7, "expected_keywords": ["Nike", "899", ["已发货", "发货"]]},
        {"turn_index": 8, "expected_keywords": ["ORD-20240115-001", "899"]}
      ],
      "compaction": {"required": true, "expected_summary_contains": ["ORD-20240115-001"], "forbidden_summary_contains": []}
    },
    {
      "id": "context_02",
      "description": "先咨询商品，再切换到订单物流查询",
      "turns": [
        "我之前买过 AirPods，想先了解一下这个商品。",
        "它的主要功能和价格是什么？",
        "我还想问一下保护壳是否适配。",
        "先不看商品了，我想查一下之前那笔订单的配送情况。",
        "订单号是 ORD-20240120-002。",
        "这个订单现在发货了吗？",
        "如果还没有发货，物流查询应该怎么处理？",
        "请直接告诉我这笔订单目前的状态。"
      ],
      "expected_intent": "order_query",
      "expected_keywords": ["ORD-20240120-002", ["尚未发货", "待发货", "未发货"]],
      "expected_requires_human": false,
      "expected_tools": ["query_logistics"],
      "min_tool_calls": 1,
      "max_tokens": 30000,
      "category": "context_stress",
      "source_task_id": "55",
      "mapping_notes": "测试商品咨询上下文不能覆盖后续订单物流任务。",
      "expected_business_checks": [
        {
          "tool": "query_logistics",
          "result_keywords": ["尚未发货"],
          "arguments": {"order_id": "ORD-20240120-002"}
        }
      ],
      "context_facts": [
        {"id": "target_order", "content": "ORD-20240120-002", "introduced_at": 5, "required_at": [6, 8], "critical": true}
      ],
      "turn_assertions": [
        {"turn_index": 6, "expected_keywords": ["ORD-20240120-002", ["尚未发货", "待发货", "未发货"]]},
        {"turn_index": 8, "expected_keywords": ["ORD-20240120-002", ["尚未发货", "待发货", "未发货"]]}
      ],
      "compaction": {"required": true, "expected_summary_contains": ["ORD-20240120-002"], "forbidden_summary_contains": []}
    },
    {
      "id": "context_03",
