      "context_facts": [
        {"id": "old_order", "content": "ORD-20240115-001", "introduced_at": 1, "superseded_at": 5, "must_not_use_after": 5, "critical": true},
        {"id": "new_order", "content": "ORD-20240110-003", "introduced_at": 5, "required_at": [6, 7, 8], "critical": true}
      ],
      "turn_assertions": [
        {"turn_index": 6, "expected_tools": ["query_order"], "expected_arguments": {"order_id": "ORD-20240110-003"}, "forbidden_arguments": {"order_id": "ORD-20240115-001"}},
        {"turn_index": 8, "forbidden_arguments": {"order_id": "ORD-20240115-001"}}
      ],
      "compaction": {"required": true, "expected_summary_contains": ["ORD-20240110-003"], "forbidden_summary_contains": []}
    },
