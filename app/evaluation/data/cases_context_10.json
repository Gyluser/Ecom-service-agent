      "expected_intent": "return_request",
      "expected_keywords": ["ORD-20240110-003", "退款"],
      "expected_requires_human": false,
      "expected_tools": ["query_order", "apply_refund"],
      "min_tool_calls": 2,
      "max_tokens": 30000,
      "category": "context_stress",
      "source_task_id": "65",
      "mapping_notes": "测试未确认前不执行退款，确认后使用正确订单和原因。",
      "expected_business_checks": [
        {
          "tool": "apply_refund",
          "result_keywords": ["success", "ORD-20240110-003"],
