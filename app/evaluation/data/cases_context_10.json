      "expected_tools": ["query_order"],
      "min_tool_calls": 1,
      "max_tokens": 30000,
      "category": "context_stress",
      "source_task_id": "69",
      "mapping_notes": "测试旧订单事实被新订单事实覆盖。",
      "expected_business_checks": [
        {
          "tool": "query_order",
