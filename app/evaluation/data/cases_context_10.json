      "context_facts": [
        {"id": "refund_order", "content": "ORD-20240110-003", "introduced_at": 1, "required_at": [3, 7], "critical": true},
        {"id": "refund_reason", "content": "不想要了", "introduced_at": 6, "required_at": [7], "critical": true}
      ],
      "turn_assertions": [
        {"turn_index": 5, "forbidden_tools": ["apply_refund"]},
        {"turn_index": 6, "expected_tools": ["apply_refund"], "expected_arguments": {"order_id": "ORD-20240110-003", "reason": "不想要了"}}
      ],
      "compaction": {"required": true, "expected_summary_contains": ["ORD-20240110-003"], "forbidden_summary_contains": []}
    },
