        {
          "tool": "query_order",
          "result_keywords": ["success", "ORD-20240118-004", "审核中"],
          "arguments": {"order_id": "ORD-20240118-004"}
        }
      ],
      "context_facts": [
        {"id": "selected_order", "content": "ORD-20240118-004", "introduced_at": 7, "required_at": [8], "critical": true},
        {"id": "do_not_refund", "content": "不要再次提交退款", "introduced_at": 8, "required_at": [8], "critical": true}
      ],
      "turn_assertions": [
        {"turn_index": 1, "expected_tools": ["list_user_orders"]},
        {"turn_index": 7, "expected_tools": ["query_order"], "expected_arguments": {"order_id": "ORD-20240118-004"}},
        {"turn_index": 8, "forbidden_tools": ["apply_refund"]}
      ],
      "compaction": {"required": true, "expected_summary_contains": ["ORD-20240118-004"], "forbidden_summary_contains": []}
    },
    {
      "id": "context_04",
      "description": "退款意图经过多轮确认后才执行",
      "turns": [
        "我想处理订单 ORD-20240110-003 的售后问题。",
        "商品是手机，我现在不太想要了。",
        "请先告诉我这笔订单目前是否已经签收。",
        "我还想确认一下退款原因应该怎么填写。",
        "先不要提交申请，我需要考虑一下。",
        "我确认要申请退款，原因是不想要了。",
        "订单号还是 ORD-20240110-003，请按刚才的原因提交。",
        "提交后告诉我预计处理时间。"
