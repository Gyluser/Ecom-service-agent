      "expected_intent": "return_request",
      "expected_keywords": ["ORD-20240118-004", "审核中"],
      "expected_requires_human": false,
      "expected_tools": ["list_user_orders", "query_order"],
      "min_tool_calls": 2,
      "max_tokens": 30000,
      "category": "context_stress",
      "source_task_id": "73",
      "mapping_notes": "测试工具结果中的订单列表与后续指定订单之间的跨轮连续性，且不得重复退款。",
      "expected_business_checks": [
        {
          "tool": "list_user_orders",
          "result_keywords": ["success", "ORD-20240118-004"],
          "arguments": {}
